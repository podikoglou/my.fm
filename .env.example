# Copy this file to .env at the repository root and fill in the values.
# Never commit .env.

# Spotify application credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Discord webhook that receives the Cloudflare alerts. It is used at deploy
# time only and is not bound to the Worker.
DISCORD_ALERT_WEBHOOK=

# Custom hostname for the preview stage. Leave it empty to serve the stage's
# workers.dev URL.
WEBSITE_DOMAIN_PREVIEW=
