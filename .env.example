# Copy this file to .env at the repository root and fill in the values.
# Never commit .env.

# Signing secret for Better Auth cookies and tokens.
BETTER_AUTH_SECRET=

# Public origin of the web application. The browser reaches Better Auth
# through the app Worker, so both values are the app origin.
# Local development uses the app Worker on port 3000.
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Spotify application credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must be the app origin plus the Better Auth Spotify callback path, and must
# match the redirect URI registered in the Spotify application.
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/callback/spotify
