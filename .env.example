# Copy this file to .env at the repository root and fill in the values.
# Never commit .env.
#
# The app and API share one origin. Better Auth derives its base URL, trusted
# origin, and Spotify callback from each request, so no origin or redirect
# value is configured here. Alchemy also generates the Better Auth signing
# secret and stores it in stack state, so it is not an environment value.
#
# The Spotify callback is the deployed app origin plus
# `/api/auth/callback/spotify`. Register that exact URL in the Spotify
# application.

# Spotify application credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
