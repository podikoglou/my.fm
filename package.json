{
  "name": "my.fm",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "api/",
    "app/",
    "worker-api/"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "alchemy dev",
    "dev:proxy": "caddy run --config Caddyfile",
    "dev:packages": "turbo dev",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "typecheck:infra": "tsgo --noEmit -p tsconfig.alchemy.json",
    "fmt": "turbo fmt",
    "fmt:check": "turbo fmt:check",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:studio": "turbo db:studio"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@cloudflare/workers-types": "4.20260702.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@effect/platform-bun": "^4.1.3",
    "@effect/platform-node": "^4.1.3",
    "@types/bun": "^1.3.12",
    "@typescript/native-preview": "^7.0.0-dev.20260423.1",
    "alchemy": "2.0.0-beta.85",
    "effect": "^4.1.4",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "turbo": "^2.9.6"
  }
}
