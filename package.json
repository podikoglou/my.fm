{
  "name": "my.fm",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "app/",
    "worker-api/"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "alchemy dev",
    "dev:proxy": "caddy run --config Caddyfile",
    "dev:packages": "turbo dev",
    "deploy": "alchemy deploy",
    "deploy:preview": "alchemy deploy --stage preview",
    "destroy": "alchemy destroy",
    "destroy:preview": "alchemy destroy --stage preview",
    "typecheck:infra": "tsgo --noEmit -p tsconfig.json",
    "fmt": "turbo fmt",
    "fmt:check": "turbo fmt:check",
    "lint": "bun run --cwd app typegen && oxlint",
    "lint:fix": "bun run lint --fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "turbo db:generate"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@cloudflare/oxlint-config": "0.1.0",
    "@cloudflare/workers-types": "4.20260702.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@effect/platform-bun": "^4.1.3",
    "@effect/platform-node": "^4.1.3",
    "@oxlint/plugins": "1.94.0",
    "@timmo001/oxlint-rules": "0.7.1",
    "@types/bun": "^1.3.12",
    "@typescript/native-preview": "^7.0.0-dev.20260423.1",
    "alchemy": "2.0.0-beta.85",
    "effect": "^4.1.4",
    "oxfmt": "^0.41.0",
    "oxlint": "1.94.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "turbo": "^2.9.6"
  }
}
