# Copy this file to .env and fill in development values. Never commit .env.

# Signing secret for Better Auth cookies and tokens.
BETTER_AUTH_SECRET=

# Public URL of this Worker. Alchemy dev uses port 1337 by default.
BETTER_AUTH_URL=http://localhost:1337

# Origin of the web application, used for CORS and trusted origins.
FRONTEND_URL=http://localhost:3000

# Spotify application credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must match the redirect URI registered in the Spotify application.
SPOTIFY_REDIRECT_URI=http://localhost:1337/api/auth/callback/spotify
